{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/ctx.mjs\" hook session-start", "timeout": 10 } ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/ctx.mjs\" hook session-end", "timeout": 10 } ]
      }
    ]
  }
}
